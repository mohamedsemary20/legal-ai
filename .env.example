# Add your API key here, then save as .env

# Free option (recommended): Get a free API key from https://console.groq.com
GROQ_API_KEY=your-groq-key-here

# Or use OpenAI (paid)
OPENAI_API_KEY=your-openai-key-here

# Production only: frontend origins allowed by CORS (comma-separated)
# ALLOWED_ORIGINS=https://your-site.netlify.app

# Google Sign-In: OAuth 2.0 Web Client ID from https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Secret used to sign session JWTs — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Postgres connection string (auto-injected by Railway's database addon)
# DATABASE_URL=postgresql://...
